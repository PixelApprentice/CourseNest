# ==============================================================================
# CourseNest — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
DEBUG=true
PORT=8000

# ------------------------------------------------------------------------------
# 2. CLIENT / FRONTEND (Vite)
# ------------------------------------------------------------------------------
VITE_APP_TITLE=CourseNest
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_OFFLINE_MODE=true
VITE_DEFAULT_LOCALE=en

# ------------------------------------------------------------------------------
# 3. BACKEND API & CENTRAL SERVER (FastAPI)
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="CourseNest API"

# Database Configuration (PostgreSQL for backend/cloud sync)
# In Docker Compose, host is 'postgres'; for bare-metal localhost use 'localhost'
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=coursenest
POSTGRES_PASSWORD=coursenest_dev_secret_change_in_prod
POSTGRES_DB=coursenest
DATABASE_URL=postgresql+asyncpg://coursenest:coursenest_dev_secret_change_in_prod@localhost:5432/coursenest

# SQLite Local Database (Desktop & Offline clients)
SQLITE_DB_PATH=./data/coursenest.db

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure random 32-byte key: openssl rand -hex 32
SECRET_KEY=dev_insecure_secret_key_must_be_overridden_in_production_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# ------------------------------------------------------------------------------
# 5. STORAGE & UPLOADS
# ------------------------------------------------------------------------------
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=500
ALLOWED_UPLOAD_EXTENSIONS=["zip","tar","gz","pdf","mp4","webm","docx","pptx","html"]

# ------------------------------------------------------------------------------
# 6. AI PROVIDERS (For automated course structuring & curriculum assistance)
# ------------------------------------------------------------------------------
# Default provider options: "ollama" (local/offline), "anthropic", "openai"
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron:3.5

# Optional cloud AI keys (leave blank if running purely offline with Ollama):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
