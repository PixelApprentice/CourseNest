# pnpm configuration for native builds
node-linker=hoisted
public-hoist-pattern[]=*sqlite*
public-hoist-pattern[]=*electron*
public-hoist-pattern[]=*node-gyp*

# Allow build scripts for native dependencies
# In pnpm v10, build scripts are blocked by default. Use `pnpm approve-builds` to allow specific packages.
# Alternatively, set to true to allow all (less secure)
# allow-builds=true

# Better-sqlite3 prefers prebuilt binaries
better-sqlite3.binary.host=linux-x64
better-sqlite3.binary.napi_versions[]=93
better-sqlite3.binary.napi_versions[]=94
better-sqlite3.binary.napi_versions[]=95

# Use prebuilt binaries
safer-dependencies=false
