{
  "name": "coursenest",
  "version": "1.1.0",
  "private": true,
  "description": "CourseNest — AI-assisted, local-first educational platform",
  "scripts": {
    "dev": "pnpm --filter @coursenest/client dev",
    "dev:desktop": "pnpm --filter @coursenest/desktop dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/**' build",
    "build:client": "pnpm --filter @coursenest/client build",
    "build:desktop": "pnpm --filter @coursenest/desktop build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:linux": "bash scripts/install_linux.sh",
    "postinstall": "node scripts/ensure_electron.cjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "tar": ">=7.5.19"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1"
  }
}
