{
  "name": "@coursenest/desktop",
  "version": "1.1.0",
  "description": "CourseNest Desktop - Fast, Private, Offline-First Learning Platform",
  "author": "CourseNest Authors",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "predev": "node ../../scripts/ensure_electron.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && cp -r ../client/dist/* dist/renderer/",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "clean": "rm -rf dist dist-electron out",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@coursenest/config": "workspace:*",
    "@coursenest/database-contracts": "workspace:*",
    "@coursenest/domain": "workspace:*",
    "@coursenest/sqlite-adapter": "workspace:*",
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
